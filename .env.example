# MongoDB
MDB_CONNECT=mongodb://127.0.0.1:27017/ai_marketplace

# Server
PORT=4100
NODE_ENV=development

# Auth — production REQUIRES strong secrets (>= 24 chars); server refuses to boot otherwise
JWT_SECRET=phai-market-dev-secret-change-me
REFRESH_TOKEN_SECRET=phai-market-dev-refresh-change-me
JWT_EXPIRES_IN=30d
REFRESH_EXPIRES_IN=30d
# COOKIE_SAMESITE=lax
# AUTH_DB_TIMEOUT_MS=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://aimarkets.vn,https://www.aimarkets.vn

# Google Sign-In (Web OAuth client — same GOOGLE_CLIENT_ID / SECRET pattern as phhotel-api)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web):
#   Authorized redirect URIs (required for server redirect, avoids origin_mismatch):
#     https://api.aimarkets.vn/v1/auth/google/callback
#     http://localhost:4100/v1/auth/google/callback
#   Authorized JavaScript origins (optional; only if GIS popup is used):
#     https://aimarkets.vn
#     https://www.aimarkets.vn
#     http://localhost:4200
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Native Expo app (app.phgroup.ai-market-vn / app.phgroup.ai_market_vn)
# iOS client (bundle app.phgroup.ai-market-vn): code + PKCE exchange for redirect
#   com.googleusercontent.apps.{prefix}:/oauthredirect (no secret).
# GOOGLE_IOS_CLIENT_ID=
# Android client (package app.phgroup.ai_market_vn + signing SHA-1): accepted as
# the azp of ID tokens from the native Google SDK. Never used for code exchange.
# Android without the native SDK uses the API-hosted flow (/v1/auth/google/start?mobile=1).
# GOOGLE_ANDROID_CLIENT_ID=

# Reverse proxy (Render/NGINX/Cloudflare). Auto-on in production.
# TRUST_PROXY=1

# Redis — bật mặc định (127.0.0.1:6379). Auth đọc/ghi auth:user + auth:session.
# Tắt: REDIS_ENABLED=0
# Production: REDIS_URL=rediss://default:PASSWORD@host:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_CONNECT_TIMEOUT_MS=1500
# REDIS_COMMAND_TIMEOUT_MS=250
# CACHE_OP_TIMEOUT_MS=250

# Rate limiting (per IP)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# REFRESH_RATE_LIMIT_WINDOW_MS=900000
# REFRESH_RATE_LIMIT_MAX=60

# OpenClaw AI Markets — wildcard {userId}.openclaw.aimarkets.vn (does not use hotelId.phhotel.vn)
# AI_URL=https://ai.aimarkets.vn
# OPENCLAW_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.openclaw.aimarkets.vn
# OPENCLAW_BEARER_TOKEN=
# Must match OpenClaw gateway token (same value as hotelapp / PHGroup-AI OPENCLAW_GATEWAY_TOKEN)
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_GATEWAY_PASSWORD=   # optional; defaults to OPENCLAW_GATEWAY_TOKEN
# OPENCLAW_GATEWAY_TOKEN_SEED= # fallback when TOKEN unset (SHA256 like PHGroup-AI)
# PYTHON_AI_SHARED_SECRET=
# Temporary SSH (desktop → user sandbox), 60 minutes
# OPENCLAW_SSH_HOST_TEMPLATE={userId}.openclaw.aimarkets.vn
# OPENCLAW_SSH_PORT=22
# OPENCLAW_SSH_USER=
# 1 = accept any host sent by the client; default only *.aimarkets.vn (never *.phhotel.vn)
# OPENCLAW_SSH_ALLOW_CUSTOM_HOST=0
# SpaceBot AI Markets — dashboard + API share port 19898 on {userId}.spacebot.aimarkets.vn
# SPACEBOT_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.spacebot.aimarkets.vn
# SPACEBOT_AIMARKETS_API_URL_TEMPLATE=https://{userId}.spacebot.aimarkets.vn  # how the API reaches the instance
# SPACEBOT_DASHBOARD_SECRET=   # must match [api] auth_token in the instance config.toml
# SPACEBOT_DASHBOARD_TOKEN_SEED= # fallback when SECRET unset (SHA256 like NanoClaw)
# Key-based SSH only — sshd listens on 2222 with authorized_keys from PUT /api/ssh/authorized-key
# SPACEBOT_SSH_HOST_TEMPLATE={userId}.spacebot.aimarkets.vn
# SPACEBOT_SSH_PORT=2222
# SPACEBOT_SSH_USER=root
# SPACEBOT_SSH_ALLOW_CUSTOM_HOST=0
# NanoClaw AI Markets — dashboard on {userId}.nanoclaw.aimarkets.vn
# NANOCLAW_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.nanoclaw.aimarkets.vn
# NANOCLAW_DASHBOARD_SECRET=     # must match DASHBOARD_SECRET on the NanoClaw instance
# NANOCLAW_DASHBOARD_TOKEN_SEED= # fallback when SECRET unset (SHA256, falls back to AIMARKETS_SERVICE_SECRET)
# NANOCLAW_USE_LOGIN_PROXY=0     # 1 = launch via /login?token&autoLogin (aimarkets-proxy on the host)
# NANOCLAW_SSH_HOST_TEMPLATE={userId}.nanoclaw.aimarkets.vn
# NANOCLAW_SSH_PORT=22
# NANOCLAW_SSH_USER=
# NANOCLAW_SSH_ALLOW_CUSTOM_HOST=0
# HERMES_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.hermes.aimarkets.vn
# HERMES_BEARER_TOKEN=
# HERMES_SSH_HOST_TEMPLATE={userId}.hermes.aimarkets.vn
# HERMES_SSH_PORT=22
# HERMES_SSH_USER=
# HERMES_SSH_ALLOW_CUSTOM_HOST=0
# Per-buyer Hermes accounts (HermesAccount) — Launch creates unique username/password
# Hermes container must set (multi-tenant auth plugin):
#   HERMES_AIMARKETS_API_URL=https://api.aimarkets.vn
#   AIMARKETS_SERVICE_SECRET=<same as below>
# Operator-only shared Basic Auth (do NOT give to buyers):
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# AIMARKETS_SERVICE_SECRET=  # X-Service-Secret for OpenClaw/Hermes aimarkets usage + hermes auth verify
# OPENCLAW_AIMARKETS_MARKUP=0.25  # +25% over Featherless/OpenRouter COGS
# Monthly agent rental (OpenClaw/Hermes/SpaceBot/NanoClaw/Open WebUI/Paperclip), prepaid from wallet.
# AGENT_MONTHLY_FEE_VND=199000
# AGENT_MONTHLY_FEE_VND_OPENCLAW=199000  # optional per-agent override (HERMES, SPACEBOT, NANOCLAW, OPENWEBUI, PAPERCLIP)
# AGENT_SUBSCRIPTION_DAYS=30
# Subscription worker: auto-renew from wallet, reminders, expiry lock, data purge after retention.
# AGENT_SUBSCRIPTION_WORKER=off          # disable on extra API replicas (run on one instance only)
# AGENT_SUBSCRIPTION_TICK_MS=900000      # 15 min
# AGENT_RENEW_LEAD_HOURS=24              # auto-renew this long before expiry
# AGENT_RENEW_RETRY_HOURS=6              # retry after insufficient balance
# AGENT_RENEW_REMIND_DAYS=3              # reminder (in-app + email) before expiry
# AGENT_DATA_RETENTION_DAYS=30           # keep workspace data after expiry, then purge
# Runtime purge webhook (POST {userId, agentId}, header X-Runtime-Secret = <PREFIX>_SSO_SECRET or AIMARKETS_SERVICE_SECRET).
# Unset → purge is queued for admins (web /admin/agent-purges, API /v1/admin/agent-purges).
# OPENCLAW_AIMARKETS_PURGE_URL=https://{userId}.openclaw.aimarkets.vn/api/aimarkets/purge
# HERMES_AIMARKETS_PURGE_URL= / SPACEBOT_… / NANOCLAW_… / OPENWEBUI_… / PAPERCLIP_AIMARKETS_PURGE_URL=
# BYOK (buyers' own AI provider keys for OpenClaw) — AES-256-GCM key, random >= 32 chars.
# Changing it makes every stored provider key unreadable (buyers must re-enter).
# BYOK_ENCRYPTION_KEY=
# AI App Builder → "Push to GitHub". Optional OAuth app (github.com/settings/developers → New OAuth App);
# without it buyers can still connect with a personal access token. Tokens are sealed with BYOK_ENCRYPTION_KEY.
# Authorization callback URL must equal GITHUB_OAUTH_REDIRECT_URI (default {PUBLIC_API_URL}/v1/builder/git/github/callback).
# The OAuth return page must be listed in CORS_ORIGINS / FRONTEND_URL (mobile uses the aimarkets:// scheme).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://api.aimarkets.vn/v1/builder/git/github/callback
# Signs the Control UI market ticket; the OpenClaw gateway must resolve the SAME value
# (falls back to AIMARKETS_SERVICE_SECRET → NEST_SERVICE_AUTH_SECRET → PYTHON_AI_SHARED_SECRET on both sides).
# Together with AIMARKETS_SERVICE_SECRET it also derives the AI Markets gateway token put in the launch URL,
# so the shared gateway's OPENCLAW_GATEWAY_TOKEN (PHHotel) is not needed here.
# OPENCLAW_MARKET_TICKET_SECRET=
# Open WebUI / Paperclip — Launch returns https://{userId}.<rt>.aimarkets.vn/<sso path>?ticket=<2-min HMAC ticket>.
# Each fork verifies with the SAME secret (OPENWEBUI_SSO_SECRET / PAPERCLIP_SSO_SECRET on the service),
# falling back to AIMARKETS_RUNTIME_SSO_SECRET on both sides. Launch returns 503 while no secret is set.
# AIMARKETS_RUNTIME_SSO_SECRET=
# OPENWEBUI_SSO_SECRET=
# OPENWEBUI_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.openwebui.aimarkets.vn
# OPENWEBUI_AIMARKETS_SSO_PATH=/api/v1/aimarkets/sso
# PAPERCLIP_SSO_SECRET=
# PAPERCLIP_AIMARKETS_PUBLIC_URL_TEMPLATE=https://{userId}.paperclip.aimarkets.vn
# PAPERCLIP_AIMARKETS_SSO_PATH=/api/auth/aimarkets/sso

# AI router (denglish-api) — separate from this platform API
DENGLISH_API_URL=http://127.0.0.1:8000
DENGLISH_SERVICE_KEY=dev-denglish-service-key
# DENGLISH_TIMEOUT_MS=180000
# DENGLISH_SANDBOX=1  # fallback mock when denglish-api is unreachable (dev default)

# GPU rental (buyer self-serve pods, billed per minute from the wallet, USD)
# Pods are created through denglish-api (RunPod key lives there, not here).
# GPU_RENTAL_PROVIDER=runpod
# GPU_RENTAL_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
# GPU_RENTAL_OFFERS_TTL_MS=600000          # cache of upstream GPU offers
# GPU_RENTAL_UPSTREAM_HOST_SUFFIX=.proxy.runpod.net  # workspace proxy only forwards to these hosts
# GPU_RENTAL_MARKUP=0.3                    # sell = upstream cost × (1 + markup)
# GPU_RENTAL_MIN_PRICE=0.2                 # floor, USD/hour
# GPU_RENTAL_STORAGE_RUNNING_GB_MONTH=0.1  # upstream storage cost while running (disk + volume)
# GPU_RENTAL_STORAGE_STOPPED_GB_MONTH=0.2  # upstream volume cost while stopped
# GPU_RENTAL_DISK_GB=20
# GPU_RENTAL_VOLUME_GB=20
# GPU_RENTAL_VOLUME_GB_MAX=200
# GPU_RENTAL_MAX_GPU_COUNT=1
# GPU_RENTAL_MAX_PER_USER=2
# GPU_RENTAL_MIN_PREPAY_HOURS=1            # balance needed to create/start
# GPU_RENTAL_WARN_MINUTES=10
# GPU_RENTAL_TERMINATE_GRACE_HOURS=24      # stopped for no funds -> deleted after this
# GPU_RENTAL_TICK_MS=60000
# GPU_RENTAL_SESSION_HOURS=8               # workspace proxy cookie lifetime
# GPU_RENTAL_WORKER=off                    # disable the billing loop on extra replicas

# Model training (/training) — runs on a GPU rental workspace, billed per minute like /gpu.
# Two sources: raw datasets (JSONL/CSV/archives or a Hugging Face id) and real-world videos
# (pose keypoints → action recognition / motion scoring). Files go to MinIO (private) through
# presigned uploads, so the MinIO S3 endpoint must be reachable from browsers and GPU pods.
# TRAINING_RAW_FILE_MAX_MB=2048
# TRAINING_VIDEO_FILE_MAX_MB=1024
# TRAINING_AUDIO_FILE_MAX_MB=200
# TRAINING_DATASET_MAX_GB=20
# TRAINING_MAX_FILES=500
# TRAINING_MAX_DATASETS=50

# GPU terminal / game stream (limits)
# TERMINAL_MAX_SESSIONS=3
# GAME_MAX_SESSIONS=2
# TERMINAL_IDLE_MS=1800000
# TERMINAL_MAX_INPUT=8192
# Game/GPU stream sessions (PC web + mobile app), billed per minute from the wallet.
# Clients heartbeat every 30s; silence longer than GAME_IDLE_MS stops the session.
# GAME_IDLE_MS=300000
# GAME_BILLING_TICK_MS=60000
# GAME_NO_HEARTBEAT_MAX_MS=14400000        # cap for old clients that never heartbeat (4h)
# GAME_LOW_BALANCE_MINUTES=5               # warn the buyer when this many minutes are left
# GAME_BILLING_WORKER=off                  # disable the billing loop on extra replicas

# White-label public hosts (buyers never see upstream provider domains)
# Production only for OAuth callback URL — leave unset locally so Google redirects to localhost:4100
# AIMARKETS_API_HOST=https://api.aimarkets.vn
# AIMARKETS_AI_HOST=https://ai.aimarkets.vn
# AIMARKETS_WEB_HOST=https://aimarkets.vn

# ProxVN tunnel (proxvn_tunnel_full) — public HTTPS edge for GPU streams + seller APIs
# Run: proxvn --proto http 4100 --server 103.77.246.196:8882
# PROXVN_ENABLED=1
# PROXVN_BASE_DOMAIN=bacsycay.click
# PROXVN_SERVER=103.77.246.196:8882

# Resend — checkout success + license key (From must be a verified domain)
# https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=AI Markets <noreply@aimarkets.vn>
# EMAIL_REPLY_TO=support@aimarkets.vn
# FRONTEND_URL=https://aimarkets.vn
# SKIP_EMAIL=1

# MinIO — playground image uploads + generated media copies (<playground prefix>/gen/…)
# Without MinIO, generated media is served through signed /v1/media/<token> links (7 days).
# MEDIA_REHOST_MAX_MB=150
# AI Markets has its own MinIO (Dokploy: ai-marketplace → minio):
#   S3 API + public objects  https://cdn.aimarkets.vn   (MINIO_SERVER_URL on the MinIO service)
#   Web console              https://minio.aimarkets.vn (MINIO_BROWSER_REDIRECT_URL)
# PHHotel's MinIO (*.phhotel.vn) is never used: plain MINIO_* pointing at phhotel.vn are ignored.
# Prefer the AIMARKETS_ names (they win over plain MINIO_*).
# AIMARKETS_MINIO_ENDPOINT=https://cdn.aimarkets.vn
# AIMARKETS_MINIO_PUBLIC_URL=https://cdn.aimarkets.vn
# AIMARKETS_MINIO_BUCKET=aimarkets
# AIMARKETS_MINIO_ACCESS_KEY=
# AIMARKETS_MINIO_SECRET_KEY=
# MINIO_PLAYGROUND_PREFIX=aimarkets/playground
# MINIO_VOICE_PREFIX=aimarkets/voices
# MINIO_CONTENT_PREFIX=aimarkets/content
# MINIO_KYC_PREFIX=aimarkets/kyc
# MINIO_TRAINING_PREFIX=aimarkets/training   # private: training datasets, job bundles, trained models
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_REGION=us-east-1

# DRM for licensed film/story downloads (.aimc). Production: random >= 24 chars.
# CONTENT_DRM_SECRET=
# Public API origin for play/download URLs (no trailing slash, with or without /v1).
# PUBLIC_API_URL=https://api.aimarkets.vn

# Web wallet top-up: PayPal Orders v2 only (no Apple Pay / Google Pay on web).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX=true
# PAYPAL_VND_PER_USD=26500

# GPay (G-Pay Vietnam) — runs alongside PayPal. Virtual Account gives each user a
# VND collection account. The merchant contract is PHHotel's: GPay calls
# https://api.phhotel.vn/gpay/webhook, which relays AI Markets accounts to
# POST /v1/gpay/webhook with X-GPay-Relay-Secret.
# Sandbox VA: https://mpa-va-sandbox.g-pay.vn/api/v3
# GPAY_ENABLED=true
# GPAY_SANDBOX=true
# Same merchant credentials + private key as phhotel-api.
# QR Payment + Virtual Account (mpa-va…/api/v3):
# GPAY_MERCHANT_CODE=
# GPAY_PASSWORD=
# Payment gateway "1 cổng" (payment…g-pay.vn/api/v4). GPay issues this pair
# separately from QR/VA; it only falls back to the pair above when unset.
# GPAY_PORTAL_MERCHANT_CODE=
# GPAY_PORTAL_PASSWORD=
# Host overrides (the QR spec's mpa-va.sandbox.g-pay.vn has no DNS record).
# GPAY_VA_BASE_URL=https://mpa-va-sandbox.g-pay.vn/api/v3
# GPAY_PORTAL_BASE_URL=https://payment-sandbox.g-pay.vn/api/v4
# Empty = customer picks on GPay's page; or BANK_ATM / BANK_INTERNATIONAL / VA.
# GPAY_PORTAL_PAYMENT_METHOD=
# GPAY_QR_SOURCE_OF_FUND=VIETQR
# GPAY_QR_TERMINAL_ID=
# GPAY_QR_STORE_CODE=
# Accepts PEM or single-line base64/\\n.
# GPAY_PRIVATE_KEY=
# Optional: GPay's public keys (sandbox/product) are embedded by default.
# GPAY_PUBLIC_KEY=
# GPAY_WEBHOOK_URL=https://api.phhotel.vn/gpay/webhook
# Must equal GPAY_RELAY_SECRET in phhotel-api.
# GPAY_RELAY_SECRET=
# GPAY_BANK_CODE=VCCB
# GPAY_VA_BANK_CODE=VCCB
# GPAY_ACCOUNT_TYPE=M
# GPAY_VND_PER_USD=26500
# GPAY_MIN_TOPUP_VND=10000

# Withdrawal policy per persona (rates are fractions of the gross withdrawal).
# seller/talent/freelancer: 20% platform fee + 8% tax. employer/HR: 1% fee, min balance.
# WITHDRAW_SELLER_PLATFORM_FEE_RATE=0.2
# WITHDRAW_SELLER_TAX_RATE=0.08
# WITHDRAW_EMPLOYER_FEE_RATE=0.01
# WITHDRAW_EMPLOYER_MIN_VND=2000000
# Seller commission+tax are already taken at settlement; set true only if balances are gross.
# WITHDRAW_SELLER_CHARGE_AT_WITHDRAW=false
# Seller earnings stay on hold this long before they can be withdrawn.
# PAYOUT_HOLD_HOURS=48

# Mobile IAP. Production ALWAYS verifies with Apple / Google (IAP_SKIP_VERIFY is ignored).
# Dev skips store calls unless IAP_SKIP_VERIFY=0.
# IAP_SKIP_VERIFY=0
#
# Apple — prefer App Store Server API (.p8 In-App Purchase key):
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY=
# APPLE_IAP_BUNDLE_ID=app.phgroup.ai-market-vn
# Optional fallback for legacy receipts:
# APPLE_IAP_SHARED_SECRET=
#
# Google Play Developer API — service account JSON (raw or base64), Play Console access.
# GOOGLE_PLAY_PACKAGE_NAME=app.phgroup.ai_market_vn
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=


# Affiliate program (seller-paid commission 0–25%; the 25% cap is fixed in code)
# AFFILIATE_ATTRIBUTION_DAYS=30
# PIT withholding on affiliate income — configurable rule pending legal review
# AFFILIATE_PIT_ENABLED=true
# AFFILIATE_PIT_RATE=0.1
# AFFILIATE_PIT_THRESHOLD_VND=0   (0 = withhold on every commission)
# AFFILIATE_VND_PER_USD=26500
