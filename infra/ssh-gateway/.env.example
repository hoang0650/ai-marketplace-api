# Copy to .env (chmod 600). Never commit the real file.
AIMARKETS_API_URL=https://api.aimarkets.vn/v1
# Same value as SSH_GATEWAY_SHARED_SECRET in the API. openssl rand -base64 48
SSH_GATEWAY_SHARED_SECRET=
SSH_GATEWAY_PUBLIC_PORT=2422
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
# Optional stronger isolation if gVisor is installed on the host: runsc
SANDBOX_RUNTIME=
