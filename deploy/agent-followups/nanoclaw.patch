+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { registerHooks } from 'node:module';
+
+registerHooks({
+  resolve(specifier, context, next) {
+    if (context.parentURL?.endsWith('aimarkets-byok.ts') && specifier === './env.js') {
+      return { url: 'data:text/javascript,export function readEnvFile(){return{}}', shortCircuit: true };
+    }
+    if (context.parentURL?.endsWith('aimarkets-byok.ts') && specifier === './log.js') {
+      return { url: 'data:text/javascript,export const log={warn(){}}', shortCircuit: true };
+    }
+    return next(specifier, context);
+  },
+});
+
+const { resolveAimarketsByok } = await import('./aimarkets-byok.ts');
+const a = 'a'.repeat(24);
+const b = 'b'.repeat(24);
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'nc-secret-'));
+function write(uid, key) {
+  const file = path.join(dir, `${uid}.json`);
+  fs.writeFileSync(file, JSON.stringify({
+    v: 1,
+    userId: uid,
+    agent: 'nanoclaw',
+    keySource: 'buyer',
+    provider: 'openai',
+    baseUrl: 'https://api.openai.com/v1',
+    apiKey: key,
+    model: 'gpt-test',
+  }));
+  return file;
+}
+const fileA = write(a, 'secret-only-a');
+const fileB = write(b, 'secret-only-b');
+const own = await resolveAimarketsByok(`market-${a}`, { AIMARKETS_SECRET_FILE: fileA }, async () => {
+  throw new Error('api must not be called');
+});
+assert.equal(own.apiKey, 'secret-only-a');
+await assert.rejects(
+  () => resolveAimarketsByok(`market-${a}`, { AIMARKETS_SECRET_FILE: fileB }, async () => ({})),
+  /unavailable/,
+);
+const other = await resolveAimarketsByok(`market-${b}`, { AIMARKETS_SECRET_FILE: fileB }, async () => {
+  throw new Error('api must not be called');
+});
+assert.equal(other.apiKey, 'secret-only-b');
+assert.equal(JSON.stringify(own).includes('secret-only-b'), false);
+console.log('NanoClaw secret file: buyer A cannot read buyer B');
