  */
+import fs from 'fs';
 import path from 'path';
 import { createHash } from 'node:crypto';
 
@@ -43,6 +44,32 @@ function parseConnection(raw: unknown): AimarketsByokConnection | null {
   return conn.baseUrl && conn.apiKey && conn.model ? conn : null;
 }
 
+/**
+ * Per-tenant containers receive the buyer (or platform runtime) credential in
+ * /run/secrets/byok.json. The file is authoritative for this process: it is
+ * not cached, and a userId that does not match the group is refused.
+ * Returns null only when no secret file is configured and the default path
+ * is absent, so a shared dev process can still resolve through the API.
+ */
+function readInjectedSecret(userId: string, hostEnv: NodeJS.ProcessEnv): AimarketsByokConnection | null {
+  const configured = (hostEnv.AIMARKETS_SECRET_FILE || '').trim();
+  const filePath = configured || '/run/secrets/byok.json';
+  if (!configured && !fs.existsSync(filePath)) return null;
+  let body: Record<string, unknown>;
+  try {
+    body = JSON.parse(fs.readFileSync(filePath, 'utf8')) as Record<string, unknown>;
+  } catch {
+    throw new Error('BYOK owner mismatch');
+  }
+  const fileUser = String(body.userId || '').toLowerCase();
+  const fileAgent = String(body.agent || 'nanoclaw').toLowerCase();
+  if (fileUser !== userId || fileAgent !== 'nanoclaw') throw new Error('BYOK owner mismatch');
+  if (body.keySource === 'platform' && !String(body.model || '').trim()) body.model = 'aimarkets-platform';
+  const value = parseConnection(body);
+  if (!value) throw new Error('Buyer credentials are missing');
+  return value;
+}
+
 export async function resolveAimarketsByok(
   groupDir: string,
   hostEnv: NodeJS.ProcessEnv,
